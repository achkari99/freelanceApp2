import * as React from "react";
import {
  motion,
  useAnimationControls,
  useReducedMotion,
  type AnimationControls
} from "framer-motion";

import { cn } from "@/lib/utils";

type MotionDivProps = React.ComponentPropsWithoutRef<typeof motion.div>;

export type CardProps = Omit<MotionDivProps, "drag" | "initial" | "animate" | "whileHover" | "whileTap" | "variants" | "transition"> & {
  disabled?: boolean;
  selected?: boolean;
  draggable?: boolean;
};

export type CardState = "rest" | "hover" | "focus" | "press" | "drag" | "disabled";

type CubicBezier = [number, number, number, number];

const parseDuration = (value: string | undefined, fallback: number) => {
  if (!value) return fallback;
  const parsed = Number.parseFloat(value);
  return Number.isFinite(parsed) ? parsed : fallback;
};

export const CARD_MOTION_TOKENS = {
  duration: {
    hover: parseDuration(process.env.NEXT_PUBLIC_CARD_DUR_HOVER, 0.18),
    drag: parseDuration(process.env.NEXT_PUBLIC_CARD_DUR_DRAG, 0.12),
    settle: parseDuration(process.env.NEXT_PUBLIC_CARD_DUR_SETTLE, 0.22)
  },
  easing: {
    standard: [0.22, 1, 0.36, 1] as CubicBezier,
    spring: [0.33, 1, 0.68, 1] as CubicBezier
  }
} as const;

type CardVariant = {
  scale: number;
  y: number;
};

type ShadowVariant = {
  opacity: number;
  scale: number;
  y: number;
};

type FocusVariant = {
  opacity: number;
  scale: number;
};

export type CardMotionBundle = {
  card: Record<CardState, CardVariant>;
  shadow: Record<CardState, ShadowVariant>;
  focusRing: Record<CardState, FocusVariant>;
};

export function createCardMotionVariants(prefersReducedMotion: boolean): CardMotionBundle {
  if (prefersReducedMotion) {
    const flatCard: CardVariant = { scale: 1, y: 0 };
    const flatShadow: ShadowVariant = { opacity: 0.2, scale: 1, y: 12 };
    const flatFocus: FocusVariant = { opacity: 0, scale: 0.98 };

    return {
      card: {
        rest: flatCard,
        hover: flatCard,
        focus: flatCard,
        press: flatCard,
        drag: flatCard,
        disabled: flatCard
      },
      shadow: {
        rest: flatShadow,
        hover: flatShadow,
        focus: flatShadow,
        press: flatShadow,
        drag: flatShadow,
        disabled: flatShadow
      },
      focusRing: {
        rest: flatFocus,
        hover: flatFocus,
        focus: { opacity: 1, scale: 1 },
        press: { opacity: 1, scale: 1 },
        drag: { opacity: 1, scale: 1 },
        disabled: flatFocus
      }
    };
  }

  return {
    card: {
      rest: { scale: 1, y: 0 },
      hover: { scale: 1.012, y: -4 },
      focus: { scale: 1.012, y: -3 },
      press: { scale: 1.028, y: -6 },
      drag: { scale: 1.04, y: -8 },
      disabled: { scale: 1, y: 0 }
    },
    shadow: {
      rest: { opacity: 0.24, scale: 0.96, y: 16 },
      hover: { opacity: 0.3, scale: 1.02, y: 10 },
      focus: { opacity: 0.32, scale: 1.02, y: 8 },
      press: { opacity: 0.38, scale: 1.05, y: 6 },
      drag: { opacity: 0.44, scale: 1.08, y: 4 },
      disabled: { opacity: 0.18, scale: 0.94, y: 20 }
    },
    focusRing: {
      rest: { opacity: 0, scale: 0.96 },
      hover: { opacity: 0, scale: 0.96 },
      focus: { opacity: 1, scale: 1 },
      press: { opacity: 1, scale: 1.02 },
      drag: { opacity: 1, scale: 1.02 },
      disabled: { opacity: 0, scale: 0.94 }
    }
  };
}

type UseCardMotionArgs = {
  disabled: boolean;
  draggable: boolean;
  selected: boolean;
};

type UseCardMotionReturn = {
  state: CardState;
  controls: AnimationControls;
  shadowControls: AnimationControls;
  ringControls: AnimationControls;
  setHovering: (value: boolean) => void;
  setFocused: (value: boolean) => void;
  setPressing: (value: boolean) => void;
  onDragStartInternal: () => void;
  onDragEndInternal: () => void;
  prefersReducedMotion: boolean;
};

function useCardMotion({ disabled, draggable, selected }: UseCardMotionArgs): UseCardMotionReturn {
  const reduced = useReducedMotion();
  const prefersReducedMotion = Boolean(reduced);
  const controls = useAnimationControls();
  const shadowControls = useAnimationControls();
  const ringControls = useAnimationControls();

  const [hovering, setHovering] = React.useState(false);
  const [focused, setFocused] = React.useState(false);
  const [pressing, setPressing] = React.useState(false);
  const [dragging, setDragging] = React.useState(false);

  const variants = React.useMemo(() => createCardMotionVariants(prefersReducedMotion), [prefersReducedMotion]);

  const deriveState = React.useCallback((): CardState => {
    if (disabled) return "disabled";
    if (dragging) return "drag";
    if (pressing) return "press";
    if (focused || selected) return "focus";
    if (hovering) return "hover";
    return "rest";
  }, [disabled, dragging, pressing, focused, selected, hovering]);

  const state = deriveState();
  const previousState = React.useRef<CardState>("rest");

  React.useEffect(() => {
    const prev = previousState.current;

    const { duration, easing } = CARD_MOTION_TOKENS;

    const baseTransition = prefersReducedMotion
      ? { duration: 0 }
      : { duration: duration.hover, ease: easing.standard };

    const popTransition = prefersReducedMotion
      ? { duration: 0 }
      : { duration: duration.drag, ease: easing.spring };

    const settleTransition = prefersReducedMotion
      ? { duration: 0 }
      : { duration: duration.settle, ease: easing.spring };

    const cardVariant = variants.card[state];
    const shadowVariant = variants.shadow[state];
    const ringVariant = variants.focusRing[state];

    const transition =
      state === "drag" || state === "press"
        ? popTransition
        : state === "rest" && (prev === "drag" || prev === "press")
        ? settleTransition
        : baseTransition;

    controls.start({ ...cardVariant, transition });
    shadowControls.start({ ...shadowVariant, transition });
    ringControls.start({ ...ringVariant, transition });

    previousState.current = state;
  }, [state, variants, controls, shadowControls, ringControls, prefersReducedMotion]);

  const onDragStartInternal = React.useCallback(() => {
    if (prefersReducedMotion || disabled || !draggable) return;
    setDragging(true);
  }, [prefersReducedMotion, disabled, draggable]);

  const onDragEndInternal = React.useCallback(() => {
    if (prefersReducedMotion || disabled || !draggable) return;
    setDragging(false);
  }, [prefersReducedMotion, disabled, draggable]);

  return {
    state,
    controls,
    shadowControls,
    ringControls,
    setHovering,
    setFocused,
    setPressing,
    onDragStartInternal,
    onDragEndInternal,
    prefersReducedMotion
  };
}

export function Card({
  disabled = false,
  selected = false,
  draggable = false,
  className,
  children,
  onFocus,
  onBlur,
  onMouseEnter,
  onMouseLeave,
  onPointerDown,
  onPointerUp,
  onDragStart,
  onDragEnd,
  ...props
}: CardProps) {
  const {
    state,
    controls,
    shadowControls,
    ringControls,
    setHovering,
    setFocused,
    setPressing,
    onDragStartInternal,
    onDragEndInternal,
    prefersReducedMotion
  } = useCardMotion({ disabled, draggable, selected });

  const handleFocus = React.useCallback(
    (event: React.FocusEvent<HTMLDivElement>) => {
      if (!disabled) setFocused(true);
      onFocus?.(event);
    },
    [disabled, setFocused, onFocus]
  );

  const handleBlur = React.useCallback(
    (event: React.FocusEvent<HTMLDivElement>) => {
      setFocused(false);
      setPressing(false);
      onBlur?.(event);
    },
    [setFocused, setPressing, onBlur]
  );

  const handleMouseEnter = React.useCallback(
    (event: React.MouseEvent<HTMLDivElement>) => {
      if (!disabled) setHovering(true);
      onMouseEnter?.(event);
    },
    [disabled, setHovering, onMouseEnter]
  );

  const handleMouseLeave = React.useCallback(
    (event: React.MouseEvent<HTMLDivElement>) => {
      setHovering(false);
      setPressing(false);
      onMouseLeave?.(event);
    },
    [setHovering, setPressing, onMouseLeave]
  );

  const handlePointerDown = React.useCallback(
    (event: React.PointerEvent<HTMLDivElement>) => {
      if (disabled) return;
      const isPrimary = event.pointerType === "mouse" ? event.button === 0 : true;
      if (isPrimary) setPressing(true);
      onPointerDown?.(event);
    },
    [disabled, setPressing, onPointerDown]
  );

  const handlePointerUp = React.useCallback(
    (event: React.PointerEvent<HTMLDivElement>) => {
      setPressing(false);
      onPointerUp?.(event);
    },
    [setPressing, onPointerUp]
  );

  const mergedDragStart = React.useCallback<NonNullable<MotionDivProps["onDragStart"]>>(
    (event, info) => {
      onDragStartInternal();
      onDragStart?.(event, info);
    },
    [onDragStartInternal, onDragStart]
  );

  const mergedDragEnd = React.useCallback<NonNullable<MotionDivProps["onDragEnd"]>>(
    (event, info) => {
      onDragEndInternal();
      onDragEnd?.(event, info);
    },
    [onDragEndInternal, onDragEnd]
  );

  return (
    <motion.div
      initial={false}
      animate={controls}
      data-card-state={state}
      data-card-selected={selected || undefined}
      aria-disabled={disabled || undefined}
      className={cn(
        "card-motion group relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition-colors dark:border-slate-800 dark:bg-slate-900",
        disabled && "pointer-events-none opacity-70",
        selected && "card-motion-selected",
        className
      )}
      drag={draggable && !prefersReducedMotion}
      dragMomentum={false}
      dragElastic={0.12}
      onDragStart={mergedDragStart}
      onDragEnd={mergedDragEnd}
      onFocus={handleFocus}
      onBlur={handleBlur}
      onMouseEnter={handleMouseEnter}
      onMouseLeave={handleMouseLeave}
      onPointerDown={handlePointerDown}
      onPointerUp={handlePointerUp}
      {...props}
    >
      <motion.span aria-hidden className="card-shadow" initial={false} animate={shadowControls} />
      <motion.span aria-hidden className="card-focus-ring" initial={false} animate={ringControls} />
      <div className="relative z-10 flex flex-col gap-4" data-card-content>
        {children}
      </div>
    </motion.div>
  );
}

export function CardPlaceholder({ className, ...props }: React.HTMLAttributes<HTMLDivElement>) {
  return <div className={cn("card-placeholder", className)} aria-hidden {...props} />;
}
